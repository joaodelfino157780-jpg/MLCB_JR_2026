# Desafio NLU para Agência de Viagens

print("=" * 70)
print("LAB 04 - AULA 02 (MLCB)")
print("Desafio NLU para Agência de Viagens")
print("=" * 70)

print("\nObjetivo:")
print("Criar um protótipo de NLU capaz de identificar a intenção")
print("do usuário em mensagens relacionadas a uma agência de viagens.")

import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report

# Dataset próprio com 18 frases:
# 6 frases para cada uma das 3 intenções.

dados = {
    "texto": [
        # comprar_passagem
        "Quero comprar uma passagem para Recife",
        "Gostaria de reservar um voo para São Paulo",
        "Preciso de uma passagem aérea para Salvador",
        "Quero viajar para o Rio de Janeiro e preciso de uma passagem",
        "Como faço para comprar uma passagem para Fortaleza?",
        "Gostaria de adquirir um bilhete de avião para Brasília",

        # cancelar_reserva
        "Quero cancelar minha passagem",
        "Preciso cancelar minha reserva",
        "Gostaria de cancelar o voo que reservei",
        "Não vou mais viajar e quero cancelar minha passagem",
        "Como faço para cancelar uma reserva de viagem?",
        "Preciso desistir da viagem e cancelar minha reserva",

        # falar_atendente
        "Quero falar com um atendente",
        "Pode me transferir para um funcionário?",
        "Gostaria de conversar com uma pessoa da agência",
        "Preciso falar com alguém do atendimento",
        "Quero entrar em contato com um atendente humano",
        "Pode chamar um funcionário para me ajudar?"
    ],
    
    "intencao": [
        # comprar_passagem
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",

        # cancelar_reserva
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",

        # falar_atendente
        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente"
    ]
}

df = pd.DataFrame(dados)

print("Dataset criado com sucesso!")
print(f"Quantidade de frases: {len(df)}")
print(f"Quantidade de intenções: {df['intencao'].nunique()}")

df

print("Distribuição das intenções:")
print(df["intencao"].value_counts())

print("\nIntenções existentes:")
print(df["intencao"].unique())

print("\nPrimeiras linhas do dataset:")
display(df.head())

# X = mensagens que serão utilizadas para realizar a classificação
# y = intenção correspondente a cada mensagem

X = df["texto"]
y = df["intencao"]

print("Variável X:")
print(X.head())

print("\nVariável y:")
print(y.head())

# 70% dos dados serão utilizados para treinamento
# 30% dos dados serão utilizados para teste.

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

print(f"Quantidade de exemplos para treinamento: {len(X_train)}")
print(f"Quantidade de exemplos para teste: {len(X_test)}")

# O TfidfVectorizer transforma as frases em números.
# O modelo de Machine Learning não trabalha diretamente com texto.

vectorizer = TfidfVectorizer()

X_train_tfidf = vectorizer.fit_transform(X_train)
X_test_tfidf = vectorizer.transform(X_test)

print("Vetorização concluída!")
print(f"Formato dos dados de treino: {X_train_tfidf.shape}")
print(f"Formato dos dados de teste: {X_test_tfidf.shape}")

# LogisticRegression é um algoritmo adequado para problemas
# de classificação, inclusive classificação de textos.

model = LogisticRegression(
    random_state=42,
    max_iter=1000
)

model.fit(X_train_tfidf, y_train)

print("Modelo treinado com sucesso!")

# Realiza previsões utilizando somente os dados de teste.

y_pred = model.predict(X_test_tfidf)

accuracy = accuracy_score(y_test, y_pred)

print("=" * 50)
print("AVALIAÇÃO DO MODELO")
print("=" * 50)

print(f"Acurácia: {accuracy:.2%}")

print("\nRelatório de classificação:")
print(
    classification_report(
        y_test,
        y_pred,
        zero_division=0
    )
)

resultado_teste = pd.DataFrame({
    "Frase": X_test.values,
    "Intenção real": y_test.values,
    "Intenção prevista": y_pred
})

print("Previsões realizadas no conjunto de teste:")

display(resultado_teste)

# Estas frases NÃO fazem parte do dataset original.
# Portanto, são utilizadas para testar o modelo com exemplos novos.

frases_ineditas = [
    "Preciso de um voo para Salvador para a próxima semana",
    "Não quero mais viajar e preciso cancelar minha reserva",
    "Gostaria de conversar com uma pessoa da agência"
]

print("Frases inéditas:")
for frase in frases_ineditas:
    print("-", frase)

# Transformamos as frases inéditas utilizando o mesmo vetorizador
# utilizado durante o treinamento.

frases_ineditas_tfidf = vectorizer.transform(frases_ineditas)

# O modelo realiza as previsões.
predicoes_ineditas = model.predict(frases_ineditas_tfidf)

print("=" * 70)
print("PREDIÇÕES DAS FRASES INÉDITAS")
print("=" * 70)

for frase, intencao in zip(frases_ineditas, predicoes_ineditas):
    print(f"\nFrase: {frase}")
    print(f"Intenção prevista: {intencao}")

resultado_ineditas = pd.DataFrame({
    "Frase inédita": frases_ineditas,
    "Intenção prevista": predicoes_ineditas
})

display(resultado_ineditas)

print("=" * 70)
print("RESUMO DA ATIVIDADE")
print("=" * 70)

print(f"Total de frases no dataset: {len(df)}")
print(f"Quantidade de intenções: {df['intencao'].nunique()}")
print(f"Exemplos de treinamento: {len(X_train)}")
print(f"Exemplos de teste: {len(X_test)}")
print(f"Vetorizador utilizado: TfidfVectorizer")
print(f"Classificador utilizado: LogisticRegression")
print(f"Acurácia no conjunto de teste: {accuracy:.2%}")

print("\nPredições inéditas:")
for frase, intencao in zip(frases_ineditas, predicoes_ineditas):
    print(f"- {frase}")
    print(f"  -> {intencao}")
