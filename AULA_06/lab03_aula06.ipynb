#
# LAB 03 mantém essa regra.
# ============================================================

LIMIAR_CONFIANCA = 0.65


# ============================================================
# FUNÇÃO PRINCIPAL DE ATENDIMENTO
# ============================================================

def processar_atendimento_sac(
    mensagem_usuario: str
):

    # ========================================================
    # VERIFICAÇÃO DA ENTRADA
    # ========================================================

    if (
        not mensagem_usuario
        or not mensagem_usuario.strip()
    ):

        return (

            "N/A",

            "0.0%",

            "Aguardando mensagem...",

            """
            <div style="
                padding: 15px;
                color: #888;
            ">
                Aguardando entrada do usuário...
            </div>
            """
        )


    try:

        # ====================================================
        # STEP 1 - PRÉ-PROCESSAMENTO
        # ====================================================

        msg_limpa = preprocessar_texto(
            mensagem_usuario
        )


        # ====================================================
        # STEP 2 - VETORIZAÇÃO
        # ====================================================

        vetor_input = (

            extrair_sentence_embedding(
                msg_limpa,
                word_vectors
            )

            .reshape(
                1,
                -1
            )
        )


        # ====================================================
        # STEP 3 - PREDIÇÃO
        # ====================================================

        probabilidades = (

            modelo_nlu.predict_proba(
                vetor_input
            )[0]
        )


        # ====================================================
        # STEP 4 - MAIOR PROBABILIDADE
        # ====================================================

        idx_maior_prob = np.argmax(
            probabilidades
        )


        confianca = probabilidades[
            idx_maior_prob
        ]


        # ====================================================
        # STEP 5 - IDENTIFICAÇÃO DA INTENÇÃO
        # ====================================================

        intencao_detectada = (

            modelo_nlu.classes_[
                idx_maior_prob
            ]
        )


        # ====================================================
        # STEP 6 - FORMATAÇÃO DA CONFIANÇA
        # ====================================================

        percentual_confianca = (

            f"{confianca * 100:.1f}%"
        )


        # ====================================================
        # STEP 7 - REGRA DE FALLBACK
        # ====================================================

        if confianca >= LIMIAR_CONFIANCA:

            # ------------------------------------------------
            # CLASSIFICAÇÃO ACEITA
            # ------------------------------------------------

            classificacao_status = (

                f"IDENTIFICADO "
                f"({intencao_detectada}) "
                f"- Corte: "
                f"{LIMIAR_CONFIANCA * 100:.0f}%"
            )


            texto_resposta = (

                RESPOSTAS_PADRAO[
                    intencao_detectada
                ]
            )


        else:

            # ------------------------------------------------
            # FALLBACK
            # ------------------------------------------------

            classificacao_status = (

                "UNCERTAIN "
                "(Fallback Acionado) "
                f"- Corte: "
                f"{LIMIAR_CONFIANCA * 100:.0f}%"
            )


            texto_resposta = (

                "Desculpe, não consegui compreender "
                "com clareza a sua solicitação. "

                "Estou transferindo agora mesmo "
                "sua conversa para um de nossos "
                "atendentes. "

                "Por favor, aguarde um momento."
            )


        # ====================================================
        # CARD VISUAL
        # ====================================================

        card_resposta = f"""

        <div style="
            background-color: #f0f4f9;
            border-left: 5px solid #2b5c8f;
            padding: 15px;
            border-radius: 8px;
            margin-top: 10px;
        ">

            <h4 style="
                margin: 0 0 8px 0;
                color: #2b5c8f;
            ">
                Resposta Automática do SAC
            </h4>

            <p style="
                margin: 0;
                font-size: 15px;
                color: #1a1a1a;
            ">
                {texto_resposta}
            </p>

            <hr>

            <small style="
                color: #555;
            ">
                Limiar de confiança configurado:
                <b>
                    {LIMIAR_CONFIANCA * 100:.0f}%
                </b>
            </small>

        </div>

        """


        # ====================================================
        # RETORNO
        # ====================================================

        return (

            str(
                intencao_detectada
            ),

            percentual_confianca,

            classificacao_status,

            card_resposta
        )


    # ========================================================
    # TRATAMENTO DE ERRO
    # ========================================================

    except Exception as erro:

        print()
        print("=" * 60)
        print("ERRO NO PROCESSAMENTO")
        print("=" * 60)

        print(
            repr(erro)
        )


        return (

            "ERRO",

            "0.0%",

            "Erro no processamento",

            f"""

            <div style="
                background-color: #ffecec;
                border-left: 5px solid #d00000;
                padding: 15px;
                border-radius: 8px;
                color: #8b0000;
            ">

                <h4>
                    Erro no processamento
                </h4>

                <p>
                    {str(erro)}
                </p>

            </div>

            """
        )


