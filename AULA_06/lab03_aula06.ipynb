def preprocessar_texto(texto: str) -> str:

    """
    Realiza a limpeza e padronização do texto.

    Etapas:

    1. Converte o texto para minúsculas
    2. Remove números e caracteres especiais
    3. Processa o texto com spaCy
    4. Remove stop words
    5. Extrai os lemas
    """

    # --------------------------------------------------------
    # 1. Minúsculas
    # --------------------------------------------------------

    texto_limpo = texto.lower()


    # --------------------------------------------------------
    # 2. Remove caracteres especiais
    # --------------------------------------------------------

    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )


    # --------------------------------------------------------
    # 3. Processamento com spaCy
    # --------------------------------------------------------

    doc = nlp(
        texto_limpo
    )


    # --------------------------------------------------------
    # 4. Extração dos lemas
    # --------------------------------------------------------

    tokens = [

        token.lemma_

        for token in doc

        if (
            not token.is_stop
            and not token.is_space
            and len(token.text) > 1
        )
    ]


    # --------------------------------------------------------
    # 5. Retorna o texto limpo
    # --------------------------------------------------------

    return " ".join(tokens)


# ============================================================
# FUNÇÃO DE SENTENCE EMBEDDING
# ============================================================

def extrair_sentence_embedding(
    texto_limpo: str,
    modelo_emb
) -> np.ndarray:

    """
    Converte uma frase em um vetor de 50 dimensões.

    Utiliza Mean Pooling:
    calcula a média dos embeddings das palavras conhecidas.
    """

    # --------------------------------------------------------
    # Divide o texto em palavras
    # --------------------------------------------------------

    palavras = texto_limpo.split()


    # --------------------------------------------------------
    # Busca os vetores
    # --------------------------------------------------------

    vetores = [

        modelo_emb[p]

        for p in palavras

        if p in modelo_emb
    ]


    # --------------------------------------------------------
    # Caso nenhuma palavra seja encontrada
    # --------------------------------------------------------

    if len(vetores) == 0:

        return np.zeros(
            modelo_emb.vector_size
        )


    # --------------------------------------------------------
    # Mean Pooling
    # --------------------------------------------------------

    return np.mean(
        vetores,
        axis=0
    )


