# ============================================================
# BLOCO 2: PRÉ-PROCESSAMENTO
# ============================================================

def preprocessar_texto(texto: str) -> str:

    """
    Limpa e padroniza o texto.

    Etapas:
    1. Minúsculas
    2. Remove caracteres especiais
    3. spaCy
    4. Remove stop words
    5. Extrai lemas
    """

    # --------------------------------------------------------
    # Minúsculas
    # --------------------------------------------------------

    texto_limpo = texto.lower()


    # --------------------------------------------------------
    # Remove caracteres especiais
    # --------------------------------------------------------

    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )


    # --------------------------------------------------------
    # Processamento com spaCy
    # --------------------------------------------------------

    doc = nlp(
        texto_limpo
    )


    # --------------------------------------------------------
    # Extrai os lemas
    # --------------------------------------------------------

    tokens = [

        token.lemma_

        for token in doc

        if (
            not token.is_stop
            and not token.is_space
            and len(token.text) > 1
        )
    ]


    # --------------------------------------------------------
    # Retorna texto limpo
    # --------------------------------------------------------

    return " ".join(tokens)


# ============================================================
# FUNÇÃO DE EMBEDDING
# ============================================================

def extrair_sentence_embedding(
    texto_limpo: str,
    modelo_emb
) -> np.ndarray:

    """
    Converte uma frase em um vetor de 50 dimensões.

    Utiliza Mean Pooling.
    """

    # Divide em palavras
    palavras = texto_limpo.split()


    # Busca os vetores das palavras conhecidas
    vetores = [

        modelo_emb[p]

        for p in palavras

        if p in modelo_emb
    ]


    # --------------------------------------------------------
    # Segurança para texto sem palavras conhecidas
    # --------------------------------------------------------

    if len(vetores) == 0:

        return np.zeros(
            modelo_emb.vector_size
        )


    # --------------------------------------------------------
    # Mean Pooling
    # --------------------------------------------------------

    return np.mean(
        vetores,
        axis=0
    )


