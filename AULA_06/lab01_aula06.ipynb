# ============================================================
# BLOCO 4: MOTOR DE INFERÊNCIA
# ============================================================

# IMPORTANTE:
# No LAB 01 o limiar continua em 50%.
# O aumento para 65% será feito no LAB 02.

LIMIAR_CONFIANCA = 0.50


# ============================================================
# FUNÇÃO PRINCIPAL
# ============================================================

def processar_atendimento_sac(
    mensagem_usuario: str
):

    # ========================================================
    # 1. VERIFICAÇÃO DE MENSAGEM
    # ========================================================

    if (
        not mensagem_usuario
        or not mensagem_usuario.strip()
    ):

        return (

            "N/A",

            "0.0%",

            "Aguardando mensagem...",

            """
            <div style="
                padding: 15px;
                color: #888;
            ">
                Aguardando entrada do usuário...
            </div>
            """
        )


    try:

        # ====================================================
        # 2. PRÉ-PROCESSAMENTO
        # ====================================================

        msg_limpa = preprocessar_texto(
            mensagem_usuario
        )


        # ====================================================
        # 3. VETORIZAÇÃO
        # ====================================================

        vetor_input = (

            extrair_sentence_embedding(
                msg_limpa,
                word_vectors
            )

            .reshape(
                1,
                -1
            )
        )


        # ====================================================
        # 4. PREDIÇÃO DAS PROBABILIDADES
        # ====================================================

        probabilidades = (

            modelo_nlu.predict_proba(
                vetor_input
            )[0]
        )


        # ====================================================
        # 5. LOCALIZA A MAIOR PROBABILIDADE
        # ====================================================

        idx_maior_prob = np.argmax(
            probabilidades
        )


        confianca = probabilidades[
            idx_maior_prob
        ]


        # ====================================================
        # 6. IDENTIFICA A INTENÇÃO
        # ====================================================

        intencao_detectada = (

            modelo_nlu.classes_[
                idx_maior_prob
            ]
        )


        # ====================================================
        # 7. FORMATA A CONFIANÇA
        # ====================================================

        percentual_confianca = (

            f"{confianca * 100:.1f}%"
        )


        # ====================================================
        # 8. REGRA DE FALLBACK
        # ====================================================

        if confianca >= LIMIAR_CONFIANCA:


            # ------------------------------------------------
            # MODELO ACEITOU A CLASSIFICAÇÃO
            # ------------------------------------------------

            classificacao_status = (

                f"IDENTIFICADO "
                f"({intencao_detectada})"
            )


            texto_resposta = (

                RESPOSTAS_PADRAO[
                    intencao_detectada
                ]
            )


        else:


            # ------------------------------------------------
            # MODELO NÃO ATINGIU O LIMIAR
            # ------------------------------------------------

            classificacao_status = (

                "UNCERTAIN "
                "(Fallback Acionado)"
            )


            texto_resposta = (

                "Desculpe, não consegui compreender "
                "com clareza a sua solicitação. "
                "Estou transferindo agora mesmo "
                "sua conversa para um de nossos "
                "atendentes. Por favor, aguarde "
                "um momento."
            )


        # ====================================================
        # 9. CARD VISUAL
        # ====================================================

        card_resposta = f"""

        <div style="
            background-color: #f0f4f9;
            border-left: 5px solid #2b5c8f;
            padding: 15px;
            border-radius: 8px;
            margin-top: 10px;
        ">

            <h4 style="
                margin: 0 0 8px 0;
                color: #2b5c8f;
            ">
                Resposta Automática do SAC
            </h4>

            <p style="
                margin: 0;
                font-size: 15px;
                color: #1a1a1a;
            ">
                {texto_resposta}
            </p>

        </div>

        """


        # ====================================================
        # 10. RETORNO
        # ====================================================

        return (

            str(
                intencao_detectada
            ),

            percentual_confianca,

            classificacao_status,

            card_resposta
        )


    # ========================================================
    # TRATAMENTO DE ERROS
    # ========================================================

    except Exception as erro:

        print(
            "ERRO NO PROCESSAMENTO:",
            repr(erro)
        )


        return (

            "ERRO",

            "0.0%",

            "Erro no processamento",

            f"""

            <div style="
                background-color: #ffecec;
                border-left: 5px solid red;
                padding: 15px;
                border-radius: 8px;
            ">

                <b>Erro no processamento:</b>

                <br><br>

                {str(erro)}

            </div>

            """
        )


