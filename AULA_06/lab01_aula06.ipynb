# ============================================================
# FUNÇÃO DE PRÉ-PROCESSAMENTO
# ============================================================

def preprocessar_texto(texto: str) -> str:

    """
    Realiza a limpeza e padronização do texto:

    1. Converte para minúsculas
    2. Remove números e caracteres especiais
    3. Processa o texto com spaCy
    4. Remove stop words
    5. Extrai os lemas
    """

    # --------------------------------------------------------
    # 1. Converte para minúsculas
    # --------------------------------------------------------

    texto_limpo = texto.lower()


    # --------------------------------------------------------
    # 2. Remove números e caracteres especiais
    # --------------------------------------------------------

    texto_limpo = re.sub(
        r'[^a-záàâãéèêíïóôõöúçñ\s]',
        '',
        texto_limpo
    )


    # --------------------------------------------------------
    # 3. Processamento linguístico com spaCy
    # --------------------------------------------------------

    doc = nlp(texto_limpo)


    # --------------------------------------------------------
    # 4. Seleção dos lemas
    # --------------------------------------------------------

    tokens = [

        token.lemma_

        for token in doc

        if (
            not token.is_stop
            and not token.is_space
            and len(token.text) > 1
        )
    ]


    # --------------------------------------------------------
    # 5. Junta os lemas
    # --------------------------------------------------------

    return " ".join(tokens)


# ============================================================
# FUNÇÃO DE SENTENCE EMBEDDING
# ============================================================

def extrair_sentence_embedding(
    texto_limpo: str,
    modelo_emb
) -> np.ndarray:

    """
    Converte uma frase em um vetor denso.

    Utiliza Mean Pooling:
    calcula a média dos embeddings das palavras
    presentes no vocabulário do modelo.
    """

    # Divide a frase em palavras
    palavras = texto_limpo.split()


    # Obtém os vetores das palavras conhecidas
    vetores = [

        modelo_emb[p]

        for p in palavras

        if p in modelo_emb
    ]


    # --------------------------------------------------------
    # Segurança para frases sem palavras conhecidas
    # --------------------------------------------------------

    if len(vetores) == 0:

        return np.zeros(
            modelo_emb.vector_size
        )


    # --------------------------------------------------------
    # Mean Pooling
    # --------------------------------------------------------

    return np.mean(
        vetores,
        axis=0
    )


